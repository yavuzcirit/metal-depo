generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  active      Boolean   @default(true)
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, order])
}

model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  slug        String   @unique
  description String?
  details     String?  @db.Text
  price       Float?
  unit        String?
  images      String[]
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([active, featured])
  @@index([slug])
  @@index([code])
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  image       String
  link        String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  page        String   @default("home")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([page, active, order])
}

model PageContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  content   String?  @db.Text
  metadata  Json?
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
}
